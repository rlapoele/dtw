{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "include": [
    "src/presentation/**/*.ts",
    "src/adapters/browser/**/*.ts",
    "src/presentation/**/*.tsx",
    "test/browser/**/*.tsx",
    "test/browser/**/*.ts",
    "test/presentation/**/*.test.tsx"
  ],
  "exclude": ["src/presentation/host/workbench.worker.ts", "src/presentation/host/worker-runtime.ts", "test/browser/*.worker.ts"]
}
