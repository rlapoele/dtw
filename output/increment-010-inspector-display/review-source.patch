diff --git a/src/presentation/workbench/WorkbenchInspector/TokenEditor/editor-session.ts b/src/presentation/workbench/WorkbenchInspector/TokenEditor/editor-session.ts
new file mode 100644
index 0000000..9efc6ba
--- /dev/null
+++ b/src/presentation/workbench/WorkbenchInspector/TokenEditor/editor-session.ts
@@ -0,0 +1,151 @@
+import type { ColorLiteralInput, ColorSpace } from "@domain/color-literal";
+import { createColorLiteral } from "@domain/color-literal";
+import { convertColor } from "@domain/color-calculation";
+import {
+  integerByteDisplay,
+  integerByteIssue,
+  integerByteToNormalized,
+} from "@presentation/workbench/WorkbenchInspector/TokenEditor/integer-rgb";
+import type { ImplementedAuthoredValue } from "@domain/token";
+export { canReviseColorToken as eligible } from "@application/color-revision-policy";
+export type LiteralDraft = {
+  colorSpace: ColorSpace;
+  components: [string, string, string];
+  alpha: string;
+};
+export type DraftSession = {
+  mode: "literal" | "reference";
+  literal: LiteralDraft;
+  reference: string | null;
+  viewSpace: ColorSpace;
+  scale: "normalized" | "bytes";
+  byteText: [string, string, string] | null;
+  byteInvalid: boolean;
+  byteEdited: [boolean, boolean, boolean];
+  edited: boolean;
+};
+export function baseline(value?: ImplementedAuthoredValue): DraftSession {
+  const literal =
+    value?.kind === "literal" && value.valueType === "color"
+      ? {
+          colorSpace: value.colorSpace,
+          components: [...value.components] as [string, string, string],
+          alpha: value.alpha,
+        }
+      : {
+          colorSpace: "srgb" as const,
+          components: ["", "", ""] as [string, string, string],
+          alpha: "1",
+        };
+  return {
+    mode: value?.kind === "token-reference" ? "reference" : "literal",
+    literal,
+    reference: value?.kind === "token-reference" ? value.targetTokenId : null,
+    viewSpace: literal.colorSpace,
+    scale: "normalized",
+    byteText: null,
+    byteInvalid: false,
+    byteEdited: [false, false, false],
+    edited: false,
+  };
+}
+/** A clean editor follows applied data; representation preferences stay passive. */
+export function refreshCleanSession(
+  session: DraftSession,
+  value?: ImplementedAuthoredValue,
+): DraftSession {
+  return {
+    ...baseline(value),
+    viewSpace: session.viewSpace,
+    scale: session.scale,
+  };
+}
+export function literalIssue(literal: ColorLiteralInput): string | undefined {
+  try {
+    createColorLiteral(literal);
+    return undefined;
+  } catch (e) {
+    return e instanceof Error ? e.message : "Invalid literal";
+  }
+}
+export function displayed(s: DraftSession): LiteralDraft {
+  if (s.viewSpace === s.literal.colorSpace) return s.literal;
+  // Alpha never participates in coordinate conversion. Keep the displayed
+  // coordinates stable while its independent exact text is incomplete.
+  const r = convertColor({ ...s.literal, alpha: "1" }, s.viewSpace);
+  return r.ok
+    ? {
+        colorSpace: r.value.colorSpace,
+        components: [...r.value.components],
+        alpha: s.literal.alpha,
+      }
+    : s.literal;
+}
+export function fields(s: DraftSession): [string, string, string] {
+  const d = displayed(s);
+  return d.colorSpace === "srgb" && s.scale === "bytes"
+    ? (s.byteText ??
+        (d.components.map((x) => integerByteDisplay(x).text) as [
+          string,
+          string,
+          string,
+        ]))
+    : d.components;
+}
+export function changeView(s: DraftSession, target: ColorSpace): DraftSession {
+  if (s.byteInvalid)
+    throw new RangeError(
+      "Finish the incomplete byte entries before changing representation.",
+    );
+  const r = convertColor(s.literal, target);
+  if (!r.ok) throw new RangeError(r.message);
+  const next = { ...s, viewSpace: target };
+  if (target === "srgb" && s.scale === "bytes") fields(next);
+  return next;
+}
+export function editComponent(
+  s: DraftSession,
+  index: number,
+  text: string,
+): DraftSession {
+  const d = displayed(s);
+  const bytes = d.colorSpace === "srgb" && s.scale === "bytes";
+  const components: [string, string, string] = [...d.components];
+  if (bytes) {
+    const raw: [string, string, string] = [...fields(s)];
+    raw[index] = text;
+    const byteEdited: [boolean, boolean, boolean] = [...s.byteEdited];
+    byteEdited[index] = true;
+    try {
+      components[index] = integerByteToNormalized(text);
+    } catch {
+      return {
+        ...s,
+        byteText: raw,
+        byteEdited,
+        byteInvalid: true,
+        edited: true,
+      };
+    }
+    const invalid = raw.some(
+      (x, i) => byteEdited[i] && integerByteIssue(x) !== undefined,
+    );
+    return {
+      ...s,
+      literal: { ...d, components },
+      byteText: raw,
+      byteEdited,
+      byteInvalid: invalid,
+      edited: true,
+    };
+  }
+  components[index] = text;
+  return {
+    ...s,
+    literal: { ...d, components },
+    byteText: null,
+    byteEdited: [false, false, false],
+    byteInvalid: false,
+    edited: true,
+  };
+}
diff --git a/src/presentation/workbench/WorkbenchInspector/TokenEditor/integer-rgb.ts b/src/presentation/workbench/WorkbenchInspector/TokenEditor/integer-rgb.ts
new file mode 100644
index 0000000..ce5a736
--- /dev/null
+++ b/src/presentation/workbench/WorkbenchInspector/TokenEditor/integer-rgb.ts
@@ -0,0 +1,32 @@
+import { normalizedToByte, byteToNormalized } from "@domain/color-calculation";
+import { decimalFromCanonical, multiplyDecimals } from "@domain/decimal";
+
+/** UI-only whole-number entry. General calculation APIs remain decimal-capable. */
+export function integerByteToNormalized(text: string): string {
+  if (text !== "none") {
+    decimalFromCanonical(text);
+    if (text.includes(".")) throw new RangeError("Enter a whole number or none.");
+  }
+  return byteToNormalized(text);
+}
+export function integerByteIssue(text: string): string | undefined {
+  try { integerByteToNormalized(text); }
+  catch (error) {
+    return error instanceof RangeError && error.message.includes("budget")
+      ? error.message : "Enter a canonical whole number or none.";
+  }
+}
+/** Preserve existing calculation guards, then decide the integer from exact text. */
+export function integerByteDisplay(text: string): { text: string; approximate: boolean } {
+  normalizedToByte(text); // Resource/representation guard only; never used for rounding.
+  if (text === "none") return { text, approximate: false };
+  const exact = multiplyDecimals(decimalFromCanonical(text), decimalFromCanonical("255"));
+  const negative = exact.startsWith("-");
+  const [integer, fraction = ""] = (negative ? exact.slice(1) : exact).split(".");
+  let rounded = BigInt(integer);
+  if (fraction) {
+    const half = "5".padEnd(fraction.length, "0");
+    if (fraction > half || (fraction === half && rounded % 2n === 1n)) rounded++;
+  }
+  return { text: `${negative && rounded !== 0n ? "-" : ""}${rounded}`, approximate: fraction !== "" };
+}
