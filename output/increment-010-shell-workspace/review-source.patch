@@ -0,0 +1,131 @@
+import type { BrowserView } from "../../workspace-view";
+import type { ProjectContext } from "@application/retention/projections";
+import { Icon } from "@presentation/ui/icon";
+import { Button } from "@presentation/ui/button";
+import { identityLabels, namespaceEntryDetails } from "@presentation/token-display/identity-labels";
+export function NamespaceTree({
+  drawer,
+  project,
+  view,
+  unavailable,
+  onSelect,
+  onCreateGroup,
+  onAllContent,
+}: {
+  drawer: boolean;
+  project: ProjectContext | undefined;
+  view: BrowserView;
+  unavailable: boolean;
+  onSelect: (group: string | null) => void;
+  onCreateGroup: () => void;
+  onAllContent?: () => void;
+}) {
+  const details = project
+    ? namespaceEntryDetails(project)
+    : new Map<string, string>();
+  const labels = identityLabels(project?.groups ?? [], [
+    "Project root",
+    "All tokens",
+  ]);
+  return (
+    <>
+      <div
+        className={`sidebar-project source-compact:gap-2 flex items-center gap-2.5 ${drawer ? "px-2 pb-6" : "px-2 pb-7.5 source-compact:px-1 source-compact:pb-6.25"}`}
+      >
+        <span
+          className="project-icon place-items-center border border-border bg-background text-xs/normal font-heading h-8 w-8 grid"
+          aria-hidden="true"
+        >
+          T
+        </span>
+        <div>
+          <strong className="block text-xs/normal source-compact:text-caption">
+            {project?.project.name || "(unnamed project)"}
+          </strong>
+          <span className="block text-caption text-muted-foreground">
+            Token workbench
+          </span>
+        </div>
+      </div>
+      <div className="nav-label uppercase text-muted-foreground font-semibold px-3 pb-2.5">
+        Library
+      </div>
+      <Button
+        variant="navigation"
+        size="navigation"
+        className={`nav-item w-full ${view.kind === "all-tokens" ? "active" : ""}`}
+        aria-current={view.kind === "all-tokens" ? "true" : undefined}
+        onClick={() => {
+          onSelect(null);
+        }}
+      >
+        <Icon name="grid" className="icon block" />
+        All tokens
+        <span className="count ml-auto text-secondary font-normal">
+          {project?.tokens.length ?? 0}
+        </span>
+      </Button>
+      {onAllContent && (
+        <Button
+          variant="navigation"
+          size="navigation"
+          className={`nav-item w-full ${view.kind === "all-content" ? "active" : "text-muted-foreground"}`}
+          aria-current={view.kind === "all-content" ? "true" : undefined}
+          onClick={onAllContent}
+        >
+          All content
+        </Button>
+      )}
+      <div className="group-tree">
+        {project?.groups.map((g) => (
+          <Button
+            key={g.authored.id}
+            variant="navigation"
+            size="group"
+            className={`nav-item w-full group-item ${view.kind === "group" && view.id === g.authored.id ? "active" : ""}`}
+            aria-current={
+              view.kind === "group" && view.id === g.authored.id
+                ? "true"
+                : undefined
+            }
+            onClick={() => {
+              onSelect(g.authored.id);
+            }}
+          >
+            <Icon name="folder" className="icon block" />
+            <span className="group-label whitespace-normal block min-w-0 text-left wrap-anywhere">
+              {labels.get(g.authored.id)}
+              {details.get(JSON.stringify(["group", g.authored.id])) && (
+                <span className="block text-caption">
+                  {details.get(JSON.stringify(["group", g.authored.id]))}
+                </span>
+              )}
+            </span>
+          </Button>
+        ))}
+      </div>
+      <Button
+        className="nav-item w-full add-group text-muted-foreground mt-4"
+        variant="navigation"
+        size="navigation"
+        disabled={unavailable}
+        onClick={() => {
+          onCreateGroup();
+        }}
+      >
+        <Icon name="plus" className="icon block" />
+        New group
+      </Button>
+      <div
+        className={`sidebar-bottom mt-auto px-3 pt-8 pb-1 ${drawer ? "" : "density:hidden"}`}
+      >
+        <span className="eyebrow uppercase text-muted-foreground font-semibold">
+          Project
+        </span>
+        <span className="helper text-muted-foreground font-normal">
+          {project?.groups.length ?? 0} groups
+        </span>
+      </div>
+    </>
+  );
+}
diff --git a/src/presentation/workbench/WorkbenchNavigation/WorkbenchNavigation.tsx b/src/presentation/workbench/WorkbenchNavigation/WorkbenchNavigation.tsx
