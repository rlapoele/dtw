--- /dev/null
+++ b/src/presentation/App/components/WorkbenchLayout/WorkbenchLayout.tsx
@@ -0,0 +1,38 @@
+import type { ReactNode } from "react";
+import { ApplicationShell } from "@presentation/App/components/ApplicationShell/ApplicationShell";
+
+/** Shared frame and geometry only. Screens supply the real pane roots and policy. */
+export function WorkbenchLayout({
+  header, beforeBody, navigation, workspace, inspector, afterBody, overlays,
+  compact = false, narrow, surface, navigationCollapsed = false, inspectorCollapsed = false,
+}: {
+  header: ReactNode;
+  beforeBody?: ReactNode;
+  navigation?: ReactNode;
+  workspace: ReactNode;
+  inspector: ReactNode;
+  afterBody?: ReactNode;
+  overlays?: ReactNode;
+  compact?: boolean;
+  narrow: boolean;
+  surface: "browse" | "inspect";
+  navigationCollapsed?: boolean;
+  inspectorCollapsed?: boolean;
+}) {
+  const bodyClass = navigation !== undefined
+    ? `workbench ${narrow ? `narrow-${surface}` : ""} grid flex-1 h-0 min-h-0 overflow-hidden ${compact ? "compact-navigation" : ""} ${navigationCollapsed ? "groups-collapsed" : "groups-expanded"} ${inspectorCollapsed ? "inspector-collapsed" : "inspector-expanded"}`
+    : "projects-layout flex-1 min-h-0 grid overflow-hidden";
+  return (
+    <ApplicationShell>
+      {header}
+      {beforeBody}
+      <div className={bodyClass}>
+        {compact ? null : navigation}
+        {workspace}
+        {inspector}
+      </div>
+      {afterBody}
+      {overlays}
+    </ApplicationShell>
+  );
+}
diff --git a/src/presentation/App/components/WorkbenchLayout/hooks/useWorkbenchViewport.ts b/src/presentation/App/components/WorkbenchLayout/hooks/useWorkbenchViewport.ts
new file mode 100644
index 0000000..1dea7f8
--- /dev/null
+++ b/src/presentation/App/components/WorkbenchLayout/hooks/useWorkbenchViewport.ts
@@ -0,0 +1,23 @@
+import { useEffect, useRef, useState } from "react";
+
+type Viewport = { compact: boolean; narrow: boolean };
+/** Observe geometry without running a screen's resize/focus policy on mount. */
+export function useWorkbenchViewport(onChange: (viewport: Viewport, threshold: keyof Viewport) => void) {
+  const [viewport, setViewport] = useState<Viewport>(() => ({
+    compact: typeof window !== "undefined" && window.innerWidth < 1120,
+    narrow: typeof window !== "undefined" && window.innerWidth < 880,
+  }));
+  const current = useRef(onChange); current.current = onChange;
+  useEffect(() => {
+    const compact = matchMedia("(max-width:1119px)"), narrow = matchMedia("(max-width:879px)");
+    const update = (threshold: keyof Viewport) => {
+      const next = { compact: compact.matches, narrow: narrow.matches };
+      current.current(next, threshold);
+      setViewport(next);
+    };
+    const onCompact = () => update("compact"), onNarrow = () => update("narrow");
+    compact.addEventListener("change", onCompact); narrow.addEventListener("change", onNarrow);
+    return () => { compact.removeEventListener("change", onCompact); narrow.removeEventListener("change", onNarrow); };
+  }, []);
+  return viewport;
+}
