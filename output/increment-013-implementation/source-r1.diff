diff --git a/src/presentation/App/components/TokenWorkbench/hooks/useProjectCommands.ts b/src/presentation/App/components/TokenWorkbench/hooks/useProjectCommands.ts
new file mode 100644
index 0000000..e8dbbef
--- /dev/null
+++ b/src/presentation/App/components/TokenWorkbench/hooks/useProjectCommands.ts
@@ -0,0 +1,203 @@
+import type { HistoryDirection, HistoryState } from "@application/retention/history";
+import { useEffect, useReducer, useRef, useState } from "react";
+import type { MutableRefObject } from "react";
+import type { AuthoringCommand } from "@application/retention/ports";
+import type {
+  ProjectHeader,
+  PublicAcceptance,
+  WorkbenchHost,
+} from "@hosts/browser/protocol";
+import { UnknownWriteError } from "@hosts/browser/worker-client";
+export type CommandState = {
+  busy: boolean;
+  unknown?: Extract<PublicAcceptance, { status: "unknown" }>;
+  retainedPending?: Extract<PublicAcceptance, { status: "retained" }>;
+};
+export type CommandAction =
+  | { type: "busy"; value: boolean }
+  | { type: "unknown"; value: CommandState["unknown"] }
+  | { type: "retained"; value: CommandState["retainedPending"] };
+export function commandReducer(
+  state: CommandState,
+  action: CommandAction,
+): CommandState {
+  switch (action.type) {
+    case "busy":
+      return { ...state, busy: action.value };
+    case "unknown":
+      return { ...state, unknown: action.value };
+    case "retained":
+      return { ...state, retainedPending: action.value };
+  }
+}
+export function useProjectCommands(
+  host: WorkbenchHost,
+  current: MutableRefObject<ProjectHeader>,
+  reading: MutableRefObject<boolean>,
+  lifecycleBlocked: boolean,
+  refresh: (known?: ProjectHeader) => Promise<boolean | undefined>,
+  setReadFailure: (message: string) => void,
+  setError: (message: string) => void,
+  setNotice: (message: string) => void,
+) {
+  const [history, setHistory] = useState<HistoryState>({});
+  const historyRead = useRef(0);
+  async function refreshHistory() {
+    const generation = ++historyRead.current;
+    const baseline = current.current;
+    try {
+      const next = await host.call("historyState", {projectId: current.current.project.id, revision: current.current.revision});
+      if (generation === historyRead.current && current.current.revision === baseline.revision && current.current.incarnation === baseline.incarnation) setHistory(next ?? {});
+    } catch { /* Existing coherent read/recovery owns unavailable-state feedback. */ }
+  }
+  useEffect(() => { void refreshHistory(); }, [current.current.revision, current.current.incarnation, lifecycleBlocked]);
+  const [{ busy, unknown, retainedPending }, dispatch] = useReducer(
+    commandReducer,
+    { busy: false },
+  );
+  const setBusy = (value: boolean) => dispatch({ type: "busy", value });
+  const setUnknown = (value: CommandState["unknown"]) =>
+    dispatch({ type: "unknown", value });
+  const setRetainedPending = (value: CommandState["retainedPending"]) =>
+    dispatch({ type: "retained", value });
+  const activeMutation = useRef(false),
+    completion = useRef<(() => void) | undefined>(undefined);
+  async function execute(command: AuthoringCommand | {direction: HistoryDirection; stepId: string}): Promise<PublicAcceptance> {
+    if (
+      lifecycleBlocked ||
+      !current.current.writable ||
+      activeMutation.current ||
+      reading.current ||
+      busy ||
+      unknown ||
+      retainedPending
+    )
+      return {
+        status: "rejected",
+        reason: "Editing paused until lifecycle recovery completes.",
+      };
+    setBusy(true);
+    activeMutation.current = true;
+    setError("");
+    try {
+      let result = "direction" in command
+        ? await host.call("traverse", {...command, projectId: current.current.project.id, revision: current.current.revision})
+        : await host.call("command", {command, revision: current.current.revision});
+      if (result.status === "unknown") setUnknown(result);
+      else if (result.status === "retained") {
+        await host.call("consume", result.receipt.commandId);
+        if (result.readback === "available" && !(await refresh()))
+          result = {
+            ...result,
+            readback: "unavailable",
+            readError: "Retained, but coherent display is unavailable.",
+          };
+        if (result.readback === "unavailable") {
+          setRetainedPending(result);
+          setReadFailure(
+            result.readError ??
+              "Retained, but readback unavailable. Retry reading without repeating the write.",
+          );
+        }
+      } else if (result.status === "unchanged") {
+        setNotice("No authored change. Undo/Redo history is unchanged.");
+      } else {
+        completion.current = undefined;
+        setError(result.reason);
+      }
+      return result;
+    } catch (e) {
+      const result = {
+        status: "unknown" as const,
+        reason: e instanceof Error ? e.message : "Retained outcome unknown",
+        commandId:
+          e instanceof UnknownWriteError
+            ? e.attempt.commandId
+            : "worker-observation-lost",
+      };
+      setUnknown(result);
+      return result;
+    } finally {
+      activeMutation.current = false;
+      setBusy(false);
+      void refreshHistory();
+    }
+  }
+  async function retryReading() {
+    if (activeMutation.current || reading.current) return;
+    activeMutation.current = true;
+    setBusy(true);
+    try {
+      if (await refresh()) {
+        const finish = completion.current;
+        completion.current = undefined;
+        setRetainedPending(undefined);
+        finish?.();
+        setNotice(
+          "Retained applied state recovered. The original write was not repeated.",
+        );
+      }
+    } finally {
+      activeMutation.current = false;
+      setBusy(false);
+    }
+  }
+
+  async function check() {
+    if (activeMutation.current || reading.current) return;
+    activeMutation.current = true;
+    setBusy(true);
+    try {
+      let result = await host.call("check", null);
+      if (result.status === "unknown") {
+        setUnknown(result);
+        setError(result.reason);
+      } else {
+        setUnknown(undefined);
+        if (result.status === "retained") {
+          await host.call("consume", result.receipt.commandId);
+          if (result.readback === "available" && !(await refresh()))
+            result = { ...result, readback: "unavailable" };
+          if (result.readback === "unavailable") {
+            setRetainedPending(result);
+            setReadFailure(
+              result.readError ??
+                "Original write retained; retry coherent reading without repeating it.",
+            );
+          } else {
+            const finish = completion.current;
+            completion.current = undefined;
+            finish?.();
+            setNotice("Original command retained and completed once.");
+          }
+        } else {
+          completion.current = undefined;
+          setError(result.reason);
+        }
+      }
+    } catch (e) {
+      setError(
+        e instanceof Error
+          ? e.message
+          : "Result check failed; original outcome remains unknown.",
+      );
+    } finally {
+      activeMutation.current = false;
+      setBusy(false);
+      void refreshHistory();
+    }
+  }
+  return {
+    busy,
+    unknown,
+    retainedPending,
+    activeMutation,
+    completion,
+    history,
+    accept: (command: AuthoringCommand) => execute(command),
+    traverse: (direction: HistoryDirection, stepId: string) => execute({direction, stepId}),
+    check,
+    retryReading,
+    setBusy,
+  };
+}
diff --git a/src/presentation/App/components/TokenWorkbench/hooks/useProjectReadback.ts b/src/presentation/App/components/TokenWorkbench/hooks/useProjectReadback.ts
new file mode 100644
index 0000000..44db0e2
--- /dev/null
+++ b/src/presentation/App/components/TokenWorkbench/hooks/useProjectReadback.ts
@@ -0,0 +1,178 @@
+import { useEffect, useRef, useState } from "react";
+import type {
+  ProjectContext,
+  DisplayRow,
+  SelectedToken,
+} from "@application/retention/projections";
+import type { DiagnosticDisplay } from "@application/retention/diagnostics";
+import type { ProjectHeader, WorkbenchHost } from "@hosts/browser/protocol";
+export type Selection = { kind: "token" | "group"; id: string } | null;
+export function useProjectReadback(
+  host: WorkbenchHost,
+  initial: ProjectHeader,
+  selection: Selection,
+) {
+  const [header, setHeader] = useState(initial);
+  const [context, setContext] = useState<ProjectContext>();
+  const [rows, setRows] = useState<DisplayRow[]>([]);
+  const [complete, setComplete] = useState(false);
+  const [inspection, setInspection] = useState<SelectedToken>();
+  const [readFailure, setReadFailure] = useState("");
+  const [targetUnavailable, setTargetUnavailable] = useState("");
+  const [diagnostics, setDiagnostics] = useState<DiagnosticDisplay>();
+  const generation = useRef(0),
+    selectedGeneration = useRef(0),
+    reading = useRef(false);
+  const current = useRef(header),
+    selected = useRef(selection);
+  current.current = header;
+  selected.current = selection;
+  useEffect(() => {
+    void refresh(initial);
+    return () => {
+      generation.current++;
+      selectedGeneration.current++;
+    };
+  }, []);
+  async function refresh(known?: ProjectHeader) {
+    const version = ++generation.current;
+    selectedGeneration.current++;
+    reading.current = true;
+    setComplete(false);
+    setDiagnostics(undefined);
+    setReadFailure("");
+    try {
+      const next =
+        known ?? (await host.call("openProject", initial.project.id));
+      const data = await host.call("context", {
+        projectId: next.project.id,
+        revision: next.revision,
+      });
+      const target = selected.current;
+      let selectedRead: SelectedToken | undefined,
+        missingTarget = "";
+      if (target?.kind === "token") {
+        if (!data.tokens.some((token) => token.authored.id === target.id))
+          missingTarget =
+            "The original token no longer exists in current applied state.";
+        else
+          selectedRead = await host.call("inspection", {
+            projectId: next.project.id,
+            revision: next.revision,
+            tokenId: target.id,
+          });
+      }
+      if (version !== generation.current) return;
+      selectedGeneration.current++;
+      if (
+        target?.kind === "token" &&
+        selected.current?.kind === "token" &&
+        selected.current.id === target.id
+      ) {
+        if (selectedRead) setInspection(selectedRead);
+        setTargetUnavailable(missingTarget);
+      }
+      // Publish revision, metadata and selected applied inspection together.
+      // Advancing a revision ahead of its selected value would silently rebase
+      // the editor's preserved input before it can request deliberate review.
+      setHeader(next);
+      setContext(data);
+      setRows([]);
+      for (let offset = 0; offset < next.tokens; offset += 100) {
+        const batch = await host.call("rows", {
+          projectId: next.project.id,
+          revision: next.revision,
+          offset,
+          count: 100,
+        });
+        if (version !== generation.current) return;
+        setRows((previous) => [...previous, ...batch]);
+        await new Promise<void>((resolve) =>
+          requestAnimationFrame(() => resolve()),
+        );
+      }
+      if (version === generation.current) {
+        setComplete(true);
+        return true;
+      }
+    } catch (e) {
+      if (version === generation.current)
+        setReadFailure(e instanceof Error ? e.message : "Project unavailable.");
+    } finally {
+      if (version === generation.current) reading.current = false;
+    }
+    return false;
+  }
+  async function inspect(id: string, target = current.current) {
+    const version = ++selectedGeneration.current;
+    try {
+      const result = await host.call("inspection", {
+        projectId: target.project.id,
+        revision: target.revision,
+        tokenId: id,
+      });
+      if (
+        version === selectedGeneration.current &&
+        current.current.revision === target.revision &&
+        selected.current?.kind === "token" &&
+        selected.current.id === id
+      ) {
+        setInspection(result);
+        setTargetUnavailable("");
+      }
+      return result;
+    } catch (e) {
+      if (version === selectedGeneration.current)
+        setTargetUnavailable(
+          e instanceof Error ? e.message : "Inspection unavailable",
+        );
+    }
+  }
+
+  async function loadDiagnostics(onError: (message: string) => void) {
+    const version = generation.current,
+      target = current.current;
+    try {
+      const result = await host.call("diagnostics", {
+        projectId: target.project.id,
+        revision: target.revision,
+      });
+      if (
+        version === generation.current &&
+        current.current.revision === target.revision
+      )
+        setDiagnostics(result);
+    } catch (error) {
+      if (version === generation.current) onError(String(error));
+    }
+  }
+  function select(target: NonNullable<Selection>) {
+    selectedGeneration.current++;
+    selected.current = target;
+    setTargetUnavailable("");
+    setInspection(undefined);
+    if (target.kind === "token") void inspect(target.id);
+  }
+  function invalidate() {
+    generation.current++;
+    selectedGeneration.current++;
+  }
+  return {
+    header,
+    context,
+    rows,
+    complete,
+    inspection,
+    readFailure,
+    targetUnavailable,
+    diagnostics,
+    refresh,
+    inspect,
+    select,
+    invalidate,
+    loadDiagnostics,
+    setReadFailure,
+    reading,
+    current,
+  };
+}
diff --git a/src/presentation/App/components/TokenWorkbench/hooks/useWorkbenchHistory.ts b/src/presentation/App/components/TokenWorkbench/hooks/useWorkbenchHistory.ts
new file mode 100644
index 0000000..50733e6
--- /dev/null
+++ b/src/presentation/App/components/TokenWorkbench/hooks/useWorkbenchHistory.ts
@@ -0,0 +1,110 @@
+import { useEffect, useRef, useState } from "react";
+import type { Dispatch, SetStateAction, RefObject, MutableRefObject } from "react";
+import type { HistoryDirection, HistoryState } from "@application/retention/history";
+import type { ProjectContext } from "@application/retention/projections";
+import type { ProjectHeader, PublicAcceptance } from "@hosts/browser/protocol";
+import type { Selection } from "./useProjectReadback";
+import type { BrowserView } from "../helpers/workspace-view";
+import { historyShortcut, ownsHistoryShortcut } from "../helpers/history-shortcuts";
+type Setter<T> = Dispatch<SetStateAction<T>>;
+type Options = {
+  history: HistoryState; traverse(direction: HistoryDirection, stepId: string): Promise<PublicAcceptance>;
+  blocked: boolean; unknown: boolean; retainedPending: boolean; readFailure: string;
+  header: ProjectHeader; dialog: boolean; pending: boolean; request(action: () => void): void;
+  current: MutableRefObject<ProjectHeader>; completion: MutableRefObject<(() => void) | undefined>;
+  setDirty: Setter<boolean>; setEditorVersion: Setter<number>; setNotice: Setter<string>; setError: Setter<string>;
+  panel: RefObject<HTMLElement | null>; narrow: boolean; back(moveFocus?: boolean): void;
+  context: ProjectContext | undefined; selection: Selection; setSelection: Setter<Selection>; view: BrowserView; setView: Setter<BrowserView>;
+};
+/** Workbench delivery coordination only: captured intent, native shortcut ownership,
+ * surviving-ID browse/selection and focus. Commands stay in useProjectCommands. */
+export function useWorkbenchHistory({history, traverse, blocked, unknown, retainedPending, readFailure, header, dialog, pending, request, current, completion, setDirty, setEditorVersion, setNotice, setError, panel, narrow, back, context, selection, setSelection, view, setView}: Options) {
+  const [historyIntent, setHistoryIntent] = useState<{direction: HistoryDirection; label: string}>();
+  const historyReturn = useRef<HTMLElement | null>(null);
+  const [retry, setRetry] = useState<{direction: HistoryDirection; id: string; revision: string}>();
+  const [historyRefresh, setHistoryRefresh] = useState(0);
+  const processedRefresh = useRef(0);
+  const pendingFocus = useRef<{invoked: HTMLElement | null; direction: HistoryDirection} | undefined>(undefined);
+  const historyReason = blocked ? unknown ? "Result unknown. Check retained result before Undo/Redo." : retainedPending || readFailure ? "Current project read unavailable. Retry reading project." : !header.writable ? "Paused. Another tab has write access." : "Paused until access and retained state are checked." : dialog ? "Close the current form before Undo/Redo." : undefined;
+  function requestHistory(direction: HistoryDirection) {
+    const step = history[direction];
+    if (blocked || dialog || !step || pending) return;
+    const baseline = {revision: header.revision, incarnation: header.incarnation};
+    const invoked = document.activeElement instanceof HTMLElement ? document.activeElement : null;
+    historyReturn.current = invoked;
+    setHistoryIntent({direction, label: step.label});
+    previousGroups.current = context?.groups.map(g => g.authored) ?? [];
+    request(() => {
+      setHistoryIntent(undefined);
+      if (current.current.revision !== baseline.revision || current.current.incarnation !== baseline.incarnation) {
+        setError("Original history action is no longer available. No change was retained."); return;
+      }
+      const finish = () => {
+        setDirty(false); setEditorVersion(v => v + 1); setHistoryRefresh(v => v + 1);
+        setNotice(`${direction === "undo" ? "Undid" : "Redid"} ${step.label}.`);
+        pendingFocus.current = {invoked, direction};
+      };
+      setRetry(undefined);
+      completion.current = finish;
+      setNotice(`${direction === "undo" ? "Undoing" : "Redoing"} ${step.label}…`);
+      void traverse(direction, step.id).then(result => {
+        if (result.status === "retained" && result.readback === "available") {
+          const done = completion.current; completion.current = undefined; done?.();
+        } else if (result.status === "rejected") {
+          setNotice(""); setError(`Could not ${direction} ${step.label}. No change was retained. ${result.reason}`);
+          setRetry({direction, id: step.id, revision: baseline.revision});
+        }
+      });
+    });
+  }
+  useEffect(() => {
+    const listener = (event: KeyboardEvent) => {
+      const direction = historyShortcut(event);
+      if (direction && ownsHistoryShortcut(event.target) && !blocked && !pending && history[direction]) {
+        event.preventDefault(); requestHistory(direction);
+      }
+    };
+    document.addEventListener("keydown", listener);
+    return () => document.removeEventListener("keydown", listener);
+  });
+  useEffect(() => {
+    if (!historyRefresh || historyRefresh === processedRefresh.current || !context) return;
+    processedRefresh.current = historyRefresh;
+    if (selection && !(selection.kind === "token" ? context.tokens : context.groups).some(item => item.authored.id === selection.id)) {
+      setSelection(null); setDirty(false); setEditorVersion(v => v + 1);
+      if (narrow) back(false);
+      setNotice(previous => `${previous} Selected ${selection.kind} was removed.`);
+    }
+    if (view.kind === "group" && !context.groups.some(g => g.authored.id === view.id)) {
+      // Follow the previous scope's authored parent chain, never a matching name.
+      let parent = previousGroups.current.find(g => g.id === view.id)?.parentGroupId ?? null;
+      const seen = new Set<string>();
+      while (parent && !context.groups.some(g => g.authored.id === parent) && !seen.has(parent)) {
+        seen.add(parent); parent = previousGroups.current.find(g => g.id === parent)?.parentGroupId ?? null;
+      }
+      setView(parent ? {kind: "group", id: parent} : {kind: "all-tokens"});
+    }
+  }, [historyRefresh, context]);
+  const previousGroups = useRef(context?.groups.map(g => g.authored) ?? []);
+
+  useEffect(() => {
+    const target = pendingFocus.current;
+    if (!target || blocked) return;
+    const opposite = target.direction === "undo" ? "redo" : "undo";
+    if (!history[opposite]) return;
+    pendingFocus.current = undefined;
+    requestAnimationFrame(() => {
+      const invoked = target.invoked;
+      if (invoked?.matches("[data-history]")) {
+        const current = document.querySelector<HTMLElement>(`[data-history="${target.direction}"]:not(:disabled)`);
+        const fallback = document.querySelector<HTMLElement>(`[data-history="${opposite}"]:not(:disabled)`);
+        (current ?? fallback ?? panel.current)?.focus({preventScroll: true});
+      } else if (!invoked?.isConnected || invoked.closest("[hidden]")) {
+        const heading = panel.current?.querySelector<HTMLElement>("h1");
+        if (heading) heading.tabIndex = -1;
+        (heading ?? panel.current)?.focus({preventScroll: true});
+      }
+    });
+  }, [historyRefresh, blocked, history]);
+  return {historyReason, historyIntent, historyReturn, requestHistory, historyRetry: retry && history[retry.direction]?.id === retry.id && header.revision === retry.revision && !blocked ? retry.direction : undefined, clearHistoryIntent: () => setHistoryIntent(undefined)};
+}
diff --git a/src/presentation/App/components/TokenWorkbench/hooks/useWorkbenchLayout.ts b/src/presentation/App/components/TokenWorkbench/hooks/useWorkbenchLayout.ts
