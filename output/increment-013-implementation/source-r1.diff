diff --git a/src/presentation/App/components/TokenWorkbench/components/TokenWorkspace/components/TokenTable/helpers/hex-preview.ts b/src/presentation/App/components/TokenWorkbench/components/TokenWorkspace/components/TokenTable/helpers/hex-preview.ts
