index 0000000..5763abc
--- /dev/null
+++ b/src/presentation/App/components/TokenWorkbench/TokenWorkbench.tsx
@@ -0,0 +1,556 @@
+import { useWorkbenchHistory } from "./hooks/useWorkbenchHistory";
+import { WorkbenchStatus } from "@presentation/App/components/TokenWorkbench/components/WorkbenchStatus/WorkbenchStatus";
+import { NavigationPane, NavigationDrawer } from "@presentation/App/components/TokenWorkbench/components/WorkbenchNavigation/WorkbenchNavigation";
+import { useWorkbenchLifecycle } from "@presentation/App/components/TokenWorkbench/hooks/useWorkbenchLifecycle";
+import { creationParent } from "@presentation/App/components/TokenWorkbench/helpers/workspace-view";
+import type { BrowserView } from "@presentation/App/components/TokenWorkbench/helpers/workspace-view";
