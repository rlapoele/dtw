-export type VisualRangeState = "available" | "outside" | "missing" | "invalid";
-
-/** Visual travel is an exact interval; binary rounding cannot establish eligibility. */
-export function visualRangeState(
-  text: string,
-  minimum: string,
-  maximum: string,
