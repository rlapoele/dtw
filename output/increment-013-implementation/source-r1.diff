+  project: ProjectContext | undefined;
+  name: string;
+  renameTarget?: string | null;
+  description: string;
+  onDescriptionChange: (value: string) => void;
+  parent: string | null;
+  layer: string;
+  readFailure: string;
+  error: string;
+  formError: Ref<HTMLParagraphElement>;
