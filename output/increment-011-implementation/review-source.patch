+++ b/src/presentation/token-display/helpers/color-preview.ts
@@ -0,0 +1,48 @@
+import { createColorLiteral } from "@domain/color-literal";
+import type { ColorLiteralInput } from "@domain/color-literal";
+
+/** Native CSS is display-only: never convert or write back authored coordinates. */
+export function colorPreview(input?: ColorLiteralInput): {
+  css?: string;
+  message: string;
+} {
+  if (!input) return { message: "Unavailable: no resolved color." };
+  let space;
+  try {
+    space = createColorLiteral(input).colorSpace;
+  } catch {
+    return {
+      message: "Unavailable: finish valid exact component and alpha entries.",
+    };
+  }
+  // Validate with the domain constructor, but serialize the original text rather
+  // than its normalized copy or a binary-number conversion.
+  const [first, second, third] = input.components;
+  const alpha = input.alpha;
+  const percent = (value: string) => value === "none" ? value : `${value}%`;
+  let css: string;
+  switch (space) {
+    case "srgb":
+    case "display-p3":
+      css = `color(${space} ${first} ${second} ${third} / ${alpha})`;
+      break;
+    case "hsl":
+      css = `hsl(${first} ${percent(second)} ${percent(third)} / ${alpha})`;
+      break;
+    case "oklab":
+    case "oklch":
+      css = `${space}(${first} ${second} ${third} / ${alpha})`;
+      break;
+  }
+  const browserCss = (globalThis as typeof globalThis & {
+    CSS?: { supports(property: string, value: string): boolean };
+  }).CSS;
+  if (browserCss && !browserCss.supports("color", css))
+    return { message: "Unavailable: this browser cannot render this color syntax." };
+  return {
+    css,
+    message: input.components.includes("none")
+      ? "Browser-rendered preview; missing components follow CSS display semantics. Authored values are unchanged."
+      : "Browser-rendered preview; appearance depends on your display. Authored values are unchanged.",
+  };
+}
diff --git a/src/presentation/token-display/helpers/identity-labels.ts b/src/presentation/token-display/helpers/identity-labels.ts
new file mode 100644
--- /dev/null
+++ b/src/presentation/token-display/helpers/identity-labels.ts
@@ -0,0 +1,128 @@
+import { namespacePathKey } from "@domain/namespace-naming";
+import type { DisplayPath } from "@application/retention/projections";
+export function pathLabel(path: DisplayPath) {
+  return path.status === "derived"
+    ? path.path.map((x) => (x === "" ? "(unnamed)" : x)).join(" / ")
+    : path.status === "unavailable"
+      ? "(derived path unavailable · resource limit)"
+      : "(invalid namespace)";
+}
+/** Labels are presentation only: all consumers keep full IDs as values and keys. */
+export function identityLabels(
+  entries: readonly { authored: { id: string }; path: DisplayPath }[],
+  reserved: readonly string[] = ["Choose a color token…", "Missing target"],
+  selfTokenId?: string,
+): Map<string, string> {
+  if (
+    new Set(entries.map((entry) => entry.authored.id)).size !== entries.length
+  )
+    throw new RangeError("Identity labels require unique stable IDs.");
+  // Context is part of the rendered choice before collision detection.
+  const bases = entries.map(
+    (entry) =>
+      pathLabel(entry.path) +
+      (entry.authored.id === selfTokenId ? " (this token)" : ""),
+  );
+  const renderedKey = (text: string) => text.replace(/\s+/g, " ").trim();
+  const reservedKeys = reserved.map(renderedKey);
+  const keys = bases.map(renderedKey);
+  const counts = (values: readonly string[]) => {
+    const result = new Map<string, number>();
+    values.forEach((value) => result.set(value, (result.get(value) ?? 0) + 1));
+    return result;
+  };
+  const baseCounts = counts(keys);
+  const ambiguous = entries.map(
+    (entry, i) =>
+      entry.path.status !== "derived" ||
+      entry.path.path.length === 0 ||
+      entry.path.path.some((part) => part === "") ||
+      reservedKeys.includes(keys[i]) ||
+      baseCounts.get(keys[i])! > 1,
+  );
+  const maximum = entries.reduce(
+    (length, entry) => Math.max(length, entry.authored.id.length),
+    8,
+  );
+  const collisions = (labels: readonly string[]) => {
+    const keys = labels.map(renderedKey),
+      labelCounts = counts(keys);
+    return keys.map(
+      (key) => reservedKeys.includes(key) || labelCounts.get(key)! > 1,
+    );
+  };
+  const result = (labels: readonly string[]) =>
+    new Map(entries.map((entry, i) => [entry.authored.id, labels[i]]));
+  // Common IDs need only the shortest distinguishing prefix. Compare the whole
+  // rendered set, including authored names that resemble an appended suffix.
+  for (let length = 8; length <= maximum + entries.length; length++) {
+    const labels = entries.map((entry, i) =>
+      ambiguous[i]
+        ? `${bases[i]} · ${entry.authored.id.slice(0, length)}`
+        : bases[i],
+    );
+    const clashes = collisions(labels);
+    if (!clashes.some(Boolean)) return result(labels);
+    clashes.forEach((collision, i) => {
+      if (collision) ambiguous[i] = true;
+    });
+  }
+  // Opaque IDs may contain whitespace or the suffix delimiter. Encode UTF-16
+  // units without whitespace/delimiters so distinct full IDs remain visible.
+  // Newly colliding authored names also gain a suffix; each pass marks another
+  // entry, making this fallback bounded even for repairable/malformed readback.
+  const escaped = entries.map((entry) =>
+    entry.authored.id
+      .split("")
+      .map((unit) => unit.charCodeAt(0).toString(16).padStart(4, "0"))
+      .join(""),
+  );
+  for (let pass = 0; pass <= entries.length; pass++) {
+    const labels = entries.map((_, i) =>
+      ambiguous[i] ? `${bases[i]} · id:${escaped[i]}` : bases[i],
+    );
+    const clashes = collisions(labels);
+    if (!clashes.some(Boolean)) return result(labels);
+    clashes.forEach((collision, i) => {
+      if (collision) ambiguous[i] = true;
+    });
+  }
+  throw new RangeError("Identity labels could not be disambiguated.");
+}
+
+/** Exceptional row context belongs inside each exact-identity action. */
+export function namespaceEntryDetails(
+  context: import("@application/retention/projections").ProjectContext,
+): Map<string, string> {
+  const entries = [
+    ...context.groups.map((entry) => ({ ...entry, kind: "group" as const })),
+    ...context.tokens.map((entry) => ({ ...entry, kind: "token" as const })),
+  ];
+  const counts = new Map<string, number>();
+  for (const entry of entries)
+    if (entry.path.status === "derived") {
+      const key = namespacePathKey(entry.path.path);
+      counts.set(key, (counts.get(key) ?? 0) + 1);
+    }
+  return new Map(
+    entries.flatMap((entry) => {
+      const issue =
+        entry.path.status !== "derived"
+          ? "Path unavailable"
+          : (counts.get(namespacePathKey(entry.path.path)) ?? 0) > 1
+            ? "Conflicting path"
+            : undefined;
+      if (!issue) return [];
+      const parent =
+        entry.authored.parentGroupId === null
+          ? "Project root"
+          : `Parent identity ${JSON.stringify(entry.authored.parentGroupId)}`;
+      return [
+        [
+          JSON.stringify([entry.kind, entry.authored.id]),
+          `${issue} · ${parent} · Identity ${JSON.stringify(entry.authored.id)}`,
+        ],
+      ];
+    }),
+  );
+}
diff --git a/src/presentation/token-display/helpers/resolved-color.ts b/src/presentation/token-display/helpers/resolved-color.ts
