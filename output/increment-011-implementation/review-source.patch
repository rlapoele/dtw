+import type { CatalogueEntry } from "@application/retention/ports";
+export function ProjectListItem({ entry, disabled, selected, onSelect }: { entry: CatalogueEntry; disabled: boolean; selected: boolean; onSelect: (entry: CatalogueEntry) => void }) {
+  return <li><button type="button" disabled={disabled} aria-pressed={selected} onClick={() => onSelect(entry)} className="project-row w-full text-left border border-border rounded-md p-4 bg-background hover:bg-row-hover aria-pressed:bg-selected disabled:opacity-45">
+    <strong className="block wrap-anywhere">{entry.status === "supported" ? entry.name || "(unnamed project)" : "Project unavailable"}</strong>
+    <span className="text-caption text-muted-foreground block mt-2">{entry.status === "supported" ? `${entry.tokens} tokens · ${entry.groups} groups` : `Project unavailable: ${entry.reason}`}</span>
+    <span className="text-caption block mt-2 wrap-anywhere">Identity: {JSON.stringify(entry.id)}</span>
+  </button></li>;
+}
diff --git a/src/presentation/projects/components/ProjectRecovery/ProjectRecovery.tsx b/src/presentation/projects/components/ProjectRecovery/ProjectRecovery.tsx
new file mode 100644
--- /dev/null
+++ b/src/presentation/projects/components/ProjectRecovery/ProjectRecovery.tsx
@@ -0,0 +1,66 @@
+import { Button } from "@presentation/ui/button";
+
+export function ProjectRecovery({
+  pending,
+  activeMutation,
+  retained,
+  unknown,
+  onCheck,
+  onRetryReading,
+  onReviewLeaving,
+}: {
+  pending: boolean;
+  activeMutation: boolean;
+  retained: boolean;
+  unknown: boolean;
+  onCheck: () => void;
+  onRetryReading: () => void;
+  onReviewLeaving: () => void;
+}) {
+  return (
+    <>
+      {pending &&
+        activeMutation &&
+        !unknown &&
+        !retained && (
+          <section role="status" className="text-caption mt-4">
+            <p>Retention or preparation pending. Inputs are preserved.</p>
+            <Button onClick={onCheck}>
+              Check retained result
+            </Button>
+          </section>
+        )}
+      {retained && (
+        <section
+          role="status"
+          className="text-caption border border-border rounded p-3 mt-5"
+        >
+          <p>
+            The project is retained. Entered input is preserved while reading
+            is unavailable; creation will not be repeated.
+          </p>
+          <Button disabled={pending} onClick={onRetryReading}>
+            Retry reading project
+          </Button>
+        </section>
+      )}
+      {unknown && (
+        <section
+          role="status"
+          className="text-caption border border-error-border rounded p-3 mt-5"
+        >
+          <p>
+            Retained result unknown. Entered name is preserved; do not repeat
+            creation.
+          </p>
+          <Button disabled={pending} onClick={onCheck}>
+            Check retained result
+          </Button>
+          <Button disabled={pending} onClick={onReviewLeaving}>
+            Review before leaving
+          </Button>
+        </section>
+      )}
+    </>
+  );
+}
diff --git a/src/presentation/projects/hooks/useProjects.ts b/src/presentation/projects/hooks/useProjects.ts
new file mode 100644
--- /dev/null
+++ b/src/presentation/projects/hooks/useProjects.ts
@@ -0,0 +1,238 @@
+import { downloadProjectBackup, readBackupFile } from "@presentation/host/backup-file";
+import { UnknownWriteError } from "@presentation/host/worker-client";
+
+import type { PublicAcceptance } from "@presentation/host/protocol";
+
+import type { RestorePreview } from "@presentation/host/protocol";
+import { useEffect, useRef, useState } from "react";
+
+import type { WorkbenchHost, ProjectHeader } from "@presentation/host/protocol";
+import type { CatalogueEntry } from "@application/retention/ports";
+
+export function useProjects(
+  host: import("react").MutableRefObject<WorkbenchHost | undefined>,
+  ensureHost: () => WorkbenchHost,
+  resetHost: () => void,
+  hasPreview: boolean,
+) {
+  const [entries, setEntries] = useState<readonly CatalogueEntry[]>();
+  const [project, setProject] = useState<ProjectHeader>();
+  const [unknown, setUnknown] =
+    useState<Extract<PublicAcceptance, { status: "unknown" }>>();
+  const [retainedId, setRetainedId] = useState<string | null>(null);
+  const activeMutation = useRef(false);
+  const commandPending = useRef(false);
+  const [backupFeedback, setBackupFeedback] = useState("");
+  const [name, setName] = useState(""),
+    [error, setError] = useState(""),
+    [pending, setPending] = useState(false),
+    [notice, setNotice] = useState("");
+  const nameRef = useRef<HTMLInputElement>(null);
+  async function catalogue() {
+    setError("");
+    setEntries(undefined);
+    try {
+      const activeHost = ensureHost();
+      await activeHost.call("ready", null);
+      setEntries(await activeHost.call("catalogue", null));
+    } catch (e) {
+      setError(e instanceof Error ? e.message : "Projects unavailable");
+    }
+  }
+  useEffect(() => {
+    void catalogue();
+  }, []);
+  useEffect(() => {
+    const guard = (event: BeforeUnloadEvent) => {
+      if (name !== "" || pending || unknown || hasPreview) {
+        event.preventDefault();
+        event.returnValue = "";
+      }
+    };
+    addEventListener("beforeunload", guard);
+    return () => removeEventListener("beforeunload", guard);
+  }, [name, pending, unknown, hasPreview]);
+  async function recoverCreated(id: string) {
+    setRetainedId(id);
+    try {
+      const next = await host.current!.call("openProject", id);
+      // A newly created/restored project may not exist in the last catalogue.
+      try { setEntries(await host.current!.call("catalogue", null)); } catch { /* Open result remains authoritative; catalogue can be retried on return. */ }
+      setProject(next);
+      setName("");
+      setRetainedId(null);
+      setNotice("Project retained in this browser.");
+    } catch (e) {
+      setError(
+        "Project retained, but reading is unavailable. " +
+          (e instanceof Error ? e.message : ""),
+      );
+    }
+  }
+  async function check() {
+    setPending(true);
+    try {
+      const result = await host.current!.call("check", null);
+      if (result.status === "unknown") {
+        setUnknown(result);
+        setError(result.reason);
+      } else {
+        setUnknown(undefined);
+        if (result.status === "retained") {
+          setRetainedId(result.receipt.result.id);
+          await host.current!.call("consume", result.receipt.commandId);
+          await recoverCreated(result.receipt.result.id);
+        } else setError(result.reason);
+      }
+    } catch (e) {
+      setError(
+        e instanceof Error
+          ? e.message
+          : "Check failed; result remains unknown.",
+      );
+    } finally {
+      setPending(false);
+    }
+  }
+  async function open(id: string) {
+    if (commandPending.current || pending || unknown || retainedId !== null || hasPreview) return;
+    setPending(true);
+    setError("");
+    try {
+      const next = await host.current!.call("openProject", id);
+      if (!entries?.some(entry => entry.status === "supported" && entry.id === id)) {
+        try { setEntries(await host.current!.call("catalogue", null)); } catch { /* Preserve successful open. */ }
+      }
+      setProject(next);
+    } catch (e) {
+      setError(e instanceof Error ? e.message : "Project unavailable");
+    } finally {
+      setPending(false);
+    }
+  }
+  async function create() {
+    if (commandPending.current || pending || unknown || retainedId !== null || hasPreview) return;
+    if (!name.trim()) {
+      setError("A project name is required.");
+      nameRef.current?.focus();
+      return;
+    }
+    setPending(true);
+    activeMutation.current = true;
+    setError("");
+    let acceptedId: string | undefined;
+    try {
+      const id = crypto.randomUUID();
+      const result = await host.current!.call("createProject", { id, name });
+      if (result.status !== "retained") {
+        if (result.status === "unknown") setUnknown(result);
+        setError(result.reason);
+        return;
+      }
+      acceptedId = id;
+      setRetainedId(id);
+      await host.current!.call("consume", result.receipt.commandId);
+      await recoverCreated(id);
+    } catch (e) {
+      const reason =
+        e instanceof Error ? e.message : "Project creation unavailable";
+      if (acceptedId === undefined)
+        setUnknown({
+          status: "unknown",
+          reason,
+          commandId:
+            e instanceof UnknownWriteError
+              ? e.attempt.commandId
+              : "worker-observation-lost",
+        });
+      setError(
+        acceptedId === undefined
+          ? reason
+          : "Project retained. Retry reading without repeating creation. " +
+              reason,
+      );
+    } finally {
+      activeMutation.current = false;
+      setPending(false);
+    }
+  }
+  async function stageBackup(file: File): Promise<RestorePreview | undefined> {
+    if (commandPending.current || pending || unknown || retainedId !== null || hasPreview) return;
+    setPending(true);
+    setError("");
+    try {
+      return await host.current!.call("stageBackup", {
+        bytes: await readBackupFile(file),
+      });
+    } catch (error) {
+      setError(
+        error instanceof Error
+          ? error.message
+          : "Backup could not be read. Browser data is unchanged.",
+      );
+    } finally {
+      setPending(false);
+    }
+  }
+  async function download(entry: Extract<CatalogueEntry, { status: "supported" }>) {
+    if (commandPending.current || pending || unknown || retainedId !== null || hasPreview) return;
+    // Capture one catalogue row, never open a project or acquire editing ownership.
