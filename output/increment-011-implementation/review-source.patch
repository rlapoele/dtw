+import { useEffect, useRef, useState } from "react";
+export function useWorkbenchLayout() {
+  const [compact, setCompact] = useState(() => window.innerWidth < 1120);
+  const [narrow, setNarrow] = useState(() => window.innerWidth < 880);
+  const [surface, setSurface] = useState<"browse" | "inspect">("browse");
+  const [navigationOpen, setNavigationOpen] = useState(false);
+  const [sidebarExpanded, setSidebarExpanded] = useState(true);
+  const [inspectorExpanded, setInspectorExpanded] = useState(true);
+  const browse = useRef<HTMLElement>(null), inspector = useRef<HTMLElement>(null), reopen = useRef<HTMLButtonElement>(null);
+  const navigationTrigger = useRef<HTMLButtonElement>(null);
+  const navigationReturn = useRef<"trigger" | "workspace">("trigger");
+  const current = useRef({ surface, inspectorExpanded }); current.current = { surface, inspectorExpanded };
+  useEffect(() => {
+    const compactMedia = matchMedia("(max-width:1119px)"), narrowMedia = matchMedia("(max-width:879px)");
+    const update = () => {
+      const focused = document.activeElement;
+      const modal = document.querySelector('[role="dialog"]');
+      const drawer = modal?.classList?.contains("navigation-drawer");
+      const navigationFocused = (focused as HTMLElement | null)?.closest?.(".sidebar,.navigation-drawer");
+      let next = current.current.surface;
+      if (!modal || drawer) {
+        if (inspector.current?.contains(focused) && current.current.inspectorExpanded) next = "inspect";
+        else if (browse.current?.contains(focused)) next = "browse";
+        if (!current.current.inspectorExpanded) next = "browse";
+      }
+      setSurface(next); setCompact(compactMedia.matches); setNarrow(narrowMedia.matches);
+      if (!compactMedia.matches) setNavigationOpen(false);
+      if (!modal || drawer) requestAnimationFrame(() => {
+        if (navigationFocused) {
+          if (drawer && compactMedia.matches) return;
+          if (compactMedia.matches) navigationTrigger.current?.focus({ preventScroll: true });
+          else document.querySelector<HTMLElement>('.sidebar [aria-current], .sidebar button')?.focus({ preventScroll: true });
+          return;
+        }
+        if (!narrowMedia.matches) return;
+        if (next === "browse" && inspector.current?.contains(focused)) focusHeading(browse.current);
+        else if (next === "inspect" && browse.current?.contains(focused)) focusHeading(inspector.current);
+      });
+    };
+    compactMedia.addEventListener("change", update); narrowMedia.addEventListener("change", update);
+    return () => { compactMedia.removeEventListener("change", update); narrowMedia.removeEventListener("change", update); };
+  }, []);
+  function showInspector() {
+    setInspectorExpanded(true); setSurface("inspect");
+    requestAnimationFrame(() => focusHeading(inspector.current));
+  }
+  function back() {
+    setSurface("browse");
+    requestAnimationFrame(() => { if (reopen.current) reopen.current.focus({ preventScroll: true }); else { const row = browse.current?.querySelector<HTMLElement>('[aria-pressed="true"]'); if (row) row.focus({ preventScroll: true }); else focusHeading(browse.current); } });
+  }
+  function navigationFinalFocus() {
+    if (document.querySelector('[role="dialog"]:not(.navigation-drawer)')) return false;
+    if (navigationReturn.current === "workspace") {
+      const heading = browse.current?.querySelector<HTMLElement>("h1");
+      if (heading) heading.tabIndex = -1;
+      return heading ?? browse.current;
+    }
+    return navigationTrigger.current;
+  }
+  return { navigationTrigger, navigationReturn, navigationFinalFocus, compact, narrow, surface, browse, inspector, reopen, showInspector, back, navigationOpen, setNavigationOpen, sidebarExpanded, setSidebarExpanded, inspectorExpanded, setInspectorExpanded };
+}
+
+function focusHeading(pane: HTMLElement | null) {
+  const heading = pane?.querySelector?.<HTMLElement>("h1,h2");
+  if (heading) heading.tabIndex = -1;
+  (heading ?? pane)?.focus({ preventScroll: true });
+}
diff --git a/src/presentation/Workbench/hooks/useWorkbenchLifecycle.ts b/src/presentation/Workbench/hooks/useWorkbenchLifecycle.ts
new file mode 100644
--- /dev/null
+++ b/src/presentation/Workbench/hooks/useWorkbenchLifecycle.ts
@@ -0,0 +1,66 @@
+import { useEffect, useRef } from "react";
+import type { WorkbenchHost, ProjectHeader } from "@presentation/host/protocol";
+/** Lifecycle recovery only. Authoring acceptance/readback keep their existing owners. */
+export function useWorkbenchLifecycle({
+  host,
+  projectId,
+  busy,
+  unknown,
+  dirty,
+  formDirty,
+  setBlocked,
+  refresh,
+  setReadFailure,
+}: {
+  host: WorkbenchHost;
+  projectId: string;
+  busy: boolean;
+  unknown: boolean;
+  dirty: boolean;
+  formDirty: boolean;
+  setBlocked(value: boolean): void;
+  refresh(header?: ProjectHeader): Promise<unknown>;
+  setReadFailure(message: string): void;
+}) {
+  const lifecycle = useRef({ busy, unknown });
+  lifecycle.current = { busy, unknown };
+  useEffect(() => {
+    const pause = () => {
+      setBlocked(true);
+      void host.call("suspend", null).catch(() => {});
+    };
+    const resume = () => {
+      setBlocked(true);
+      if (lifecycle.current.busy || lifecycle.current.unknown) return;
+      void host
+        .call("resume", projectId)
+        .then((next) => refresh(next))
+        .then(() => setBlocked(false))
+        .catch((e) =>
+          setReadFailure(
+            e instanceof Error ? e.message : "Lifecycle recovery unavailable",
+          ),
+        );
+    };
+    addEventListener("pagehide", pause);
+    addEventListener("freeze", pause);
+    addEventListener("pageshow", resume);
+    addEventListener("focus", resume);
+    return () => {
+      removeEventListener("pagehide", pause);
+      removeEventListener("freeze", pause);
+      removeEventListener("pageshow", resume);
+      removeEventListener("focus", resume);
+    };
+  }, [host, projectId]);
+  useEffect(() => {
+    const protect = (event: BeforeUnloadEvent) => {
+      if (dirty || formDirty || busy || unknown) {
+        event.preventDefault();
+        event.returnValue = "";
+      }
+    };
+    addEventListener("beforeunload", protect);
+    return () => removeEventListener("beforeunload", protect);
+  }, [dirty, formDirty, busy, unknown]);
+}
