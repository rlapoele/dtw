@@ -0,0 +1,52 @@
+import type { ComponentProps } from "react";
+import {
+  Bars3Icon,
+  ChevronDownIcon,
+  ChevronLeftIcon,
+  ChevronRightIcon,
+  FolderIcon,
+  InformationCircleIcon,
+  PlusIcon,
+  Square3Stack3DIcon,
+  Squares2X2Icon,
+  XMarkIcon,
+} from "@heroicons/react/24/outline";
+import { cn } from "@presentation/lib/cn";
+
+const icons = {
+  menu: Bars3Icon,
+  "chevron-down": ChevronDownIcon,
+  "chevron-left": ChevronLeftIcon,
+  "chevron-right": ChevronRightIcon,
+  folder: FolderIcon,
+  info: InformationCircleIcon,
+  plus: PlusIcon,
+  stack: Square3Stack3DIcon,
+  grid: Squares2X2Icon,
+  close: XMarkIcon,
+} as const;
+
+export type IconName = keyof typeof icons;
+export type IconProps = Omit<
+  ComponentProps<typeof PlusIcon>,
+  "name" | "className" | "aria-hidden" | "aria-label" | "role" | "focusable" | "children"
+> & {
+  name: IconName;
+  className?: string;
+  /** Omit for decoration; label only when the icon itself conveys meaning. */
+  label?: string;
+};
+
+export function Icon({ name, className, label, ...props }: IconProps) {
+  const Glyph = icons[name];
+  return (
+    <Glyph
+      {...props}
+      className={cn("size-4 shrink-0", className)}
+      aria-hidden={label ? undefined : true}
+      aria-label={label || undefined}
+      role={label ? "img" : undefined}
+      focusable="false"
+    />
+  );
+}
