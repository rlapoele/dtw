@@ -0,0 +1,135 @@
+import type { ChangeEventHandler, ReactNode, Ref } from "react";
+import type { CatalogueEntry } from "@application/retention/ports";
+import { Icon } from "@presentation/ui/icon";
+import { Button } from "@presentation/ui/button";
+import { ProjectList } from "./ProjectList/ProjectList";
+import { CreateProjectForm } from "./CreateProjectForm/CreateProjectForm";
+import { ProjectRecovery } from "./ProjectRecovery/ProjectRecovery";
+
+export function ProjectsScreen({
+  entries,
+  error,
+  notice,
+  name,
+  pending,
+  activeMutation,
+  retained,
+  unknown,
+  nameRef,
+  onOpen,
+  onRetryCatalogue,
+  onBackupChange,
+  onNameChange,
+  onCreate,
+  onCheck,
+  onRetryReading,
+  onReviewLeaving,
+  departureDialog,
+  restoreDialog,
+}: {
+  entries: readonly CatalogueEntry[] | undefined;
+  error: string;
+  notice: string;
+  name: string;
+  pending: boolean;
+  activeMutation: boolean;
+  retained: boolean;
+  unknown: boolean;
+  nameRef: Ref<HTMLInputElement>;
+  onOpen: (id: string) => void;
+  onRetryCatalogue: () => void;
+  onBackupChange: ChangeEventHandler<HTMLInputElement>;
+  onNameChange: (name: string) => void;
+  onCreate: () => void;
+  onCheck: () => void;
+  onRetryReading: () => void;
+  onReviewLeaving: () => void;
+  departureDialog: ReactNode;
+  restoreDialog: ReactNode;
+}) {
+  const openDisabled = pending || retained || unknown;
+  const createDisabled = openDisabled || entries === undefined;
+  return (
+    <div className="app-shell flex h-dvh min-h-0 flex-col overflow-clip bg-background">
+      <header className="shrink-0 border-b border-border h-16 flex items-center px-6 gap-5">
+        <div className="brand flex items-center gap-2.5">
+          <Icon name="stack" />
+          <strong>Token Workbench</strong>
+        </div>
+        <span className="text-caption ml-auto text-muted-foreground">
+          Browser local
+        </span>
+      </header>
+      <main className="mx-auto w-full max-w-3xl px-7 py-10 overflow-auto">
+        {
+          <>
+            <h1>Projects in this browser</h1>
+            <p className="text-muted-foreground mt-3">
+              Applied work is retained automatically. Keep independent backups:
+              browser storage can be cleared or become unavailable.
+            </p>
+            {entries === undefined ? (
+              <p role="status" className="my-5">
+                {error
+                  ? "Projects unavailable. Existing browser data is unchanged."
+                  : "Loading projects…"}
+              </p>
+            ) : entries.length === 0 ? (
+              <p className="my-5">No projects retained in this browser.</p>
+            ) : (
+              <ProjectList
+                entries={entries}
+                disabled={openDisabled}
+                onOpen={onOpen}
+              />
+            )}
+            {error && entries === undefined && (
+              <Button onClick={onRetryCatalogue}>
+                Retry reading projects
+              </Button>
+            )}
+            <section className="mt-8">
+              <h2 className="mb-3">Restore backup</h2>
+              <label className="text-caption block">
+                Project backup file
+                <input
+                  className="block mt-3 max-w-full"
+                  type="file"
+                  accept=".json,application/json"
+                  disabled={createDisabled}
+                  onChange={onBackupChange}
+                />
+              </label>
+            </section>
+            <CreateProjectForm
+              name={name}
+              disabled={createDisabled}
+              pending={pending}
+              error={error}
+              nameRef={nameRef}
+              onNameChange={onNameChange}
+              onSubmit={onCreate}
+            />
+          </>
+        }
+        <ProjectRecovery
+          pending={pending}
+          activeMutation={activeMutation}
+          retained={retained}
+          unknown={unknown}
+          onCheck={onCheck}
+          onRetryReading={onRetryReading}
+          onReviewLeaving={onReviewLeaving}
+        />
+        <p id="project-error" role="alert" className="text-destructive mt-4">
+          {error}
+        </p>
+        <p role="status" className="text-caption mt-4">
+          {notice}
+        </p>
+      </main>
+      {departureDialog}
+      {restoreDialog}
+    </div>
+  );
+}
diff --git a/src/presentation/projects/useProjects.ts b/src/presentation/projects/useProjects.ts
new file mode 100644
index 0000000..ddac203
--- /dev/null
+++ b/src/presentation/projects/useProjects.ts
@@ -0,0 +1,208 @@
+import { readBackupFile } from "@presentation/host/backup-file";
+import { UnknownWriteError } from "@presentation/host/worker-client";
+
+import type { PublicAcceptance } from "@presentation/host/protocol";
+
+import type { RestorePreview } from "@presentation/host/protocol";
+import { useEffect, useRef, useState } from "react";
+
+import type { WorkbenchHost, ProjectHeader } from "@presentation/host/protocol";
+import type { CatalogueEntry } from "@application/retention/ports";
+
+export function useProjects(
+  host: import("react").MutableRefObject<WorkbenchHost | undefined>,
+  ensureHost: () => WorkbenchHost,
+  resetHost: () => void,
+  hasPreview: boolean,
+) {
+  const [entries, setEntries] = useState<readonly CatalogueEntry[]>();
+  const [project, setProject] = useState<ProjectHeader>();
+  const [unknown, setUnknown] =
+    useState<Extract<PublicAcceptance, { status: "unknown" }>>();
+  const [retainedId, setRetainedId] = useState<string | null>(null);
+  const activeMutation = useRef(false);
+  const [name, setName] = useState(""),
+    [error, setError] = useState(""),
+    [pending, setPending] = useState(false),
+    [notice, setNotice] = useState("");
+  const nameRef = useRef<HTMLInputElement>(null);
+  async function catalogue() {
+    setError("");
+    setEntries(undefined);
+    try {
+      const activeHost = ensureHost();
+      await activeHost.call("ready", null);
+      setEntries(await activeHost.call("catalogue", null));
+    } catch (e) {
+      setError(e instanceof Error ? e.message : "Projects unavailable");
+    }
+  }
+  useEffect(() => {
+    void catalogue();
+  }, []);
+  useEffect(() => {
+    const guard = (event: BeforeUnloadEvent) => {
+      if (name !== "" || pending || unknown || hasPreview) {
+        event.preventDefault();
+        event.returnValue = "";
+      }
+    };
+    addEventListener("beforeunload", guard);
+    return () => removeEventListener("beforeunload", guard);
+  }, [name, pending, unknown, hasPreview]);
+  async function recoverCreated(id: string) {
+    setRetainedId(id);
+    try {
+      const next = await host.current!.call("openProject", id);
+      setProject(next);
+      setName("");
+      setRetainedId(null);
+      setNotice("Project retained in this browser.");
+    } catch (e) {
+      setError(
+        "Project retained, but reading is unavailable. " +
+          (e instanceof Error ? e.message : ""),
+      );
+    }
+  }
+  async function check() {
+    setPending(true);
+    try {
+      const result = await host.current!.call("check", null);
+      if (result.status === "unknown") {
+        setUnknown(result);
+        setError(result.reason);
+      } else {
+        setUnknown(undefined);
+        if (result.status === "retained") {
+          setRetainedId(result.receipt.result.id);
+          await host.current!.call("consume", result.receipt.commandId);
+          await recoverCreated(result.receipt.result.id);
+        } else setError(result.reason);
+      }
+    } catch (e) {
+      setError(
+        e instanceof Error
+          ? e.message
+          : "Check failed; result remains unknown.",
+      );
+    } finally {
+      setPending(false);
+    }
+  }
+  async function open(id: string) {
+    if (pending || unknown) return;
+    setPending(true);
+    setError("");
+    try {
+      setProject(await host.current!.call("openProject", id));
+    } catch (e) {
+      setError(e instanceof Error ? e.message : "Project unavailable");
+    } finally {
+      setPending(false);
+    }
+  }
+  async function create() {
+    if (pending || unknown || retainedId !== null) return;
+    if (!name.trim()) {
+      setError("A project name is required.");
+      nameRef.current?.focus();
+      return;
+    }
+    setPending(true);
+    activeMutation.current = true;
+    setError("");
+    let acceptedId: string | undefined;
+    try {
+      const id = crypto.randomUUID();
+      const result = await host.current!.call("createProject", { id, name });
+      if (result.status !== "retained") {
+        if (result.status === "unknown") setUnknown(result);
+        setError(result.reason);
+        return;
+      }
+      acceptedId = id;
+      setRetainedId(id);
+      await host.current!.call("consume", result.receipt.commandId);
+      await recoverCreated(id);
+    } catch (e) {
+      const reason =
+        e instanceof Error ? e.message : "Project creation unavailable";
+      if (acceptedId === undefined)
+        setUnknown({
+          status: "unknown",
+          reason,
+          commandId:
+            e instanceof UnknownWriteError
+              ? e.attempt.commandId
+              : "worker-observation-lost",
+        });
+      setError(
+        acceptedId === undefined
+          ? reason
+          : "Project retained. Retry reading without repeating creation. " +
+              reason,
+      );
+    } finally {
+      activeMutation.current = false;
+      setPending(false);
+    }
+  }
+  async function stageBackup(file: File): Promise<RestorePreview | undefined> {
+    setPending(true);
+    setError("");
+    try {
+      return await host.current!.call("stageBackup", {
+        bytes: await readBackupFile(file),
+      });
+    } catch (error) {
+      setError(
+        error instanceof Error
+          ? error.message
+          : "Backup could not be read. Browser data is unchanged.",
+      );
+    } finally {
+      setPending(false);
+    }
+  }
+  function returnToProjects(reset?: boolean) {
+    if (reset) resetHost();
+    setProject(undefined);
+    void catalogue();
+  }
+  function leaveUnknown() {
+    host.current?.fence();
+    resetHost();
+    setUnknown(undefined);
+    setRetainedId(null);
+    setName("");
+    void catalogue();
+  }
+  function retryCreated() {
+    if (retainedId !== null) {
+      setPending(true);
+      void recoverCreated(retainedId).finally(() => setPending(false));
+    }
+  }
+  return {
+    entries,
+    project,
+    unknown,
+    retainedId,
+    activeMutation,
+    name,
+    setName,
+    error,
+    pending,
+    notice,
+    nameRef,
+    catalogue,
+    check,
+    open,
+    create,
+    stageBackup,
+    returnToProjects,
+    leaveUnknown,
+    retryCreated,
+  };
+}
